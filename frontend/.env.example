# Optional. Copy this file to .env only if you need to override the defaults.

# Backend base URL. Leave unset to use /api, which Vite proxies to Flask on
# http://127.0.0.1:5001 in development and vercel.json rewrites in production.
# VITE_API_URL=http://127.0.0.1:5001

# true = fake buses from src/mock/, false = call GET /buses on the backend (default)
VITE_USE_MOCK=false
